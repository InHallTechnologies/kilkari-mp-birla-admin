# Same Firebase project as kilkari-mp-birla (the field-worker app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional bootstrap: comma-separated emails that are treated as admin even before
# USERS_ARCHIVE/{uid}/access === "admin" is set. Leave empty in production.
VITE_ADMIN_EMAILS=
